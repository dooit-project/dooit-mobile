{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "mock"
      }
    },
    "outside-capture": {
      "developmentClient": true,
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "mock",
        "EXPO_PUBLIC_ENABLE_OUTSIDE_CAPTURE": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "real",
        "EXPO_PUBLIC_API_URL": "https://macmini.tail68d2d1.ts.net"
      }
    },
    "cloudflare-test": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_MODE": "real",
        "EXPO_PUBLIC_API_URL": "https://bullet-applicant-divine-search.trycloudflare.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_MODE": "real",
        "EXPO_PUBLIC_API_URL": "https://macmini.tail68d2d1.ts.net"
      }
    }
  }
}
